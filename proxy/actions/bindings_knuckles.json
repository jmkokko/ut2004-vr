{
  "controller_type": "knuckles",
  "name": "UT2004VR default (knuckles)",
  "description": "L stick move / click jump, L trigger dodge, L grip crouch, L B menu (hold: recenter), L A scoreboard; R stick turn/teleport / click next weapon, R trigger fire, R grip alt-fire, A next, B previous weapon",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/turn"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/jump"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/dodge"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "grab",
          "inputs": {
            "grab": {
              "output": "/actions/main/in/crouch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/scoreboard"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/nextweapon"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/fire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "grab",
          "inputs": {
            "grab": {
              "output": "/actions/main/in/altfire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/nextweapon"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/prevweapon"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/pose_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/pose_right",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}