{
  "controller_type": "hpmotioncontroller",
  "name": "UT2004VR defaults (HP Reverb G2)",
  "description": "L stick move (gaze steers) / click jump, L trigger dodge, L grip crouch, Y menu (hold: recenter), X scoreboard; R stick turn/teleport / click use (enter or leave a vehicle), R trigger fire, R grip alt-fire, A next, B previous weapon",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/turn"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/jump"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/dodge"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/crouch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/scoreboard"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/use"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/fire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/altfire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/nextweapon"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/prevweapon"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/pose_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/pose_right",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}