{
  "controller_type": "holographic_controller",
  "name": "UT2004VR default (holographic_controller)",
  "description": "L stick move / click horn (in vehicles), L trigger dodge, L grip jump; R stick back crouch, L menu (hold: recenter), L touchpad scoreboard; R stick turn/teleport / click use (enter or leave a vehicle), R trigger fire, R grip alt-fire, R touchpad next, R menu previous weapon",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/turn"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/horn"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/dodge"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/jump"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/scoreboard"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/use"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/fire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/altfire"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/nextweapon"
            }
          }
        },
        {
          "path": "/user/hand/right/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/prevweapon"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/pose_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/pose_right",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}